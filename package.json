{
  "name": "gap-tool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:pages:bundle && npm run build:northstar:bundle",
    "build:pages": "npm run typecheck && npm run build:pages:bundle",
    "build:pages:bundle": "node scripts/prepare-pages-build.mjs && vite build --mode github-pages --outDir docs --emptyOutDir false && node scripts/finalize-pages-build.mjs",
    "build:northstar": "npm run typecheck && npm run build:northstar:bundle",
    "build:northstar:bundle": "vite build --mode northstar --outDir dist --emptyOutDir true",
    "test:formulas": "tsx scripts/verify-advisor-formulas.ts",
    "test:client-exchange": "node --import tsx scripts/verify-client-profile-exchange.ts",
    "docs:module-wiring": "node scripts/generate-module-wiring-html.mjs",
    "preview": "vite preview",
    "preview:northstar": "vite preview --outDir dist",
    "lint": "tsc --noEmit",
    "deploy": "pwsh ./deploy-pages.ps1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-dropdown-menu": "^2",
    "@radix-ui/react-navigation-menu": "^1",
    "@radix-ui/react-select": "^2",
    "@radix-ui/react-slot": "^1",
    "@remixicon/react": "^4",
    "clsx": "^2",
    "date-fns": "^4",
    "lucide-react": "^0",
    "react": "^19",
    "react-day-picker": "^8",
    "react-dom": "^19",
    "react-router-dom": "^7",
    "recharts": "^2",
    "tailwind-merge": "^3",
    "tailwind-variants": "^0",
    "zod": "^3",
    "zustand": "^5"
  },
  "devDependencies": {
    "@faker-js/faker": "^9",
    "@tailwindcss/forms": "^0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "^6"
  }
}
